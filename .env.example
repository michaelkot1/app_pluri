# Copy to .env and fill in real values. Never commit .env.
WORKOUTX_API_KEY=""
WORKOUTX_ENDPOINT="https://api.workoutxapp.com/v1"

SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
# Server-side only. Used by Scripts/mirror_exercise_media.mjs to write Storage
# and public.exercises. Never ship in the iOS app.
SUPABASE_SECRET_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side only (Supabase Edge Function). Never ship in the iOS app.
GEMINI_API_KEY=""

NUTRITION_API_KEY=""

# RevenueCat public Apple SDK key. Injected via generate_secrets.sh → Secrets.revenueCatAPIKey.
# This key is OPTIONAL and has three intentional states:
#   appl_…  Subscriptions enabled. Required before App Store submission.
#   ""      Subscriptions disabled: Purchases is never configured, paywalls show
#           an "aren't set up yet" state, and entitlement gating is not enforced,
#           so TestFlight testers can use the app. Archives fine.
#   test_…  Test Store key — Debug only. RevenueCat traps at configure time
#           outside Debug, so Release builds ignore it and stay disabled.
REVENUECAT_API_KEY=""
