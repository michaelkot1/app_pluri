# Copy to .env and fill in real values. Never commit .env.
WORKOUTX_API_KEY=""
WORKOUTX_ENDPOINT="https://api.workoutxapp.com/v1"

SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
# New-format keys (dashboard). Keep for server/docs; do not inject into iOS yet —
# supabase-swift still sends supabaseKey as Authorization Bearer (JWT-only).
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# Legacy JWT anon key (eyJ…). Injected into the iOS app via generate_secrets.sh.
SUPABASE_ANON_KEY=""
# Server-side only. Never ship in the iOS bundle.
SUPABASE_SERVICE_ROLE_KEY=""

# Server-side only (Supabase Edge Function). Never ship in the iOS app.
GEMINI_API_KEY=""

NUTRITION_API_KEY=""

# RevenueCat public Apple SDK key (appl_...). Injected via generate_secrets.sh → Secrets.revenueCatAPIKey.
REVENUECAT_API_KEY=""
